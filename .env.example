# The Engine Room — environment configuration
# Copy to .env.local for local dev, or feed these as real env vars in production.
# Everything is OFF by default: with none of this set the app runs as an open
# demo. Turn features on as you need them.

# ─── Accounts, plans & billing (the product mode) ─────────────────────────────
# Turn on login/signup, Free vs Pro, per-account worlds, and page gating.
ENGINE_ROOM_AUTH=1
# HMAC key for session cookies. MUST be a strong random value in production.
#   generate: openssl rand -hex 32
ENGINE_ROOM_SESSION_SECRET=change-me-openssl-rand-hex-32
# Operator key for the /admin console and POST /api/billing/confirm.
#   generate: openssl rand -hex 24
ENGINE_ROOM_ADMIN_KEY=change-me-operator-key
# Optional Payoneer "Request a Payment" link shown on the upgrade screen.
# ENGINE_ROOM_PAYONEER_LINK=https://payoneer.com/pay/your-link

# ─── Email (password reset + verification) ────────────────────────────────────
# Delivery uses the first provider set, else the /admin "Mail to relay" outbox.
# Option A — Resend (recommended; no SDK, just the API key):
# RESEND_API_KEY=re_...
# ENGINE_ROOM_EMAIL_FROM=Engine Room <noreply@yourdomain.com>   # verified domain
# Option B — generic webhook: POST {to,subject,text,link} as JSON to your handler
# (SendGrid/Postmark/Zapier/Make/your own).
# ENGINE_ROOM_EMAIL_WEBHOOK=https://your-email-webhook
# Public base URL used in email links (defaults to the request origin).
# ENGINE_ROOM_PUBLIC_URL=https://engine.yourcompany.com

# ─── Persistence ──────────────────────────────────────────────────────────────
# Durable world snapshot. In Docker this is set to /data/world.json on a volume.
# ENGINE_ROOM_DATA=.data/world.json
ENGINE_ROOM_PERSIST=1

# ─── Partner API access (optional, independent of accounts) ────────────────────
# Comma-separated key or key:tenant entries for /api access via x-api-key.
# ENGINE_ROOM_API_KEYS=erk_partner_1:acme,erk_partner_2:globex
# Fixed-window rate limit, requests/min per caller (off when unset).
# ENGINE_ROOM_RATE_LIMIT=120

# ─── Integrations (optional) ──────────────────────────────────────────────────
# Run intake extraction through Claude (else the deterministic parser is used).
# ANTHROPIC_API_KEY=sk-ant-...
# Require signed WhatsApp webhook deliveries (Meta app secret).
# ENGINE_ROOM_WHATSAPP_SECRET=your-meta-app-secret
